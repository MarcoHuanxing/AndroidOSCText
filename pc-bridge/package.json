{
  "name": "androidosctext-pc-bridge",
  "version": "0.2.0",
  "description": "LAN bridge: Android phone text -> VRChat OSC chatbox",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": { "aost-bridge": "src/index.js" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:bundle": "node scripts/bundle.mjs",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": { "node": ">=18" },
  "keywords": ["vrchat", "osc", "chatbox", "lan", "accessibility"],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
